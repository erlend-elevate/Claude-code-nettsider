---
const certifications = [
  { name: 'NAF-godkjent', icon: '🛡️' },
  { name: 'Miljøfyrtårn', icon: '🌿' },
  { name: 'Autorisert', icon: '✅' },
  { name: 'Elbil-sertifisert', icon: '⚡' },
];

const team = [
  { name: 'Erik Nordvik', role: 'Daglig leder & mestermek.', years: '20 år' },
  { name: 'Marte Solheim', role: 'Serviceleder', years: '12 år' },
  { name: 'Jonas Berg', role: 'Elbil-spesialist', years: '8 år' },
  { name: 'Silje Haugen', role: 'Kundemottaker', years: '6 år' },
];
---

<section id="om-oss" class="py-20 sm:py-28 bg-surface-alt">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Left: Image Placeholder -->
      <div class="animate-on-scroll slide-left">
        <div class="relative">
          <div class="aspect-[4/3] bg-gradient-to-br from-primary/10 to-primary/5 rounded-2xl border border-border flex items-center justify-center">
            <div class="text-center">
              <svg class="w-16 h-16 mx-auto text-primary/30 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3H21m-3.75 3H21" />
              </svg>
              <p class="text-primary/40 text-sm font-medium">Verksted-bilde</p>
            </div>
          </div>
          <!-- Experience badge -->
          <div class="absolute -bottom-5 -right-5 bg-primary text-white rounded-2xl p-5 shadow-xl">
            <div class="font-heading font-extrabold text-3xl">15+</div>
            <div class="text-white/70 text-sm font-medium">års erfaring</div>
          </div>
        </div>
      </div>

      <!-- Right: Content -->
      <div class="animate-on-scroll slide-right">
        <span class="inline-block text-accent font-semibold text-sm tracking-wider uppercase mb-3">Om oss</span>
        <h2 class="font-heading text-3xl sm:text-4xl font-bold text-primary mb-6">
          Kvalitet og tillit i over 15 år
        </h2>
        <p class="text-text-muted text-lg leading-relaxed mb-4">
          Motorverk Bergen ble grunnlagt i 2009 av Erik Nordvik med en enkel visjon: å tilby autorisert kvalitet med personlig service. Fra en liten garasje på Minde har vi vokst til et moderne verksted med 8 sertifiserte mekanikere.
        </p>
        <p class="text-text-muted text-lg leading-relaxed mb-8">
          Vi er stolte av å være NAF-godkjent og Miljøfyrtårn-sertifisert. Vårt team kombinerer dyp fagkompetanse med en genuin interesse for å levere det beste til hver enkelt kunde.
        </p>

        <!-- Certifications -->
        <div class="flex flex-wrap gap-3 mb-8">
          {certifications.map((cert) => (
            <span class="inline-flex items-center gap-2 bg-white px-4 py-2 rounded-full border border-border text-sm font-medium text-primary shadow-sm">
              <span>{cert.icon}</span>
              {cert.name}
            </span>
          ))}
        </div>
      </div>
    </div>

    <!-- Team Section -->
    <div class="mt-20">
      <div class="text-center mb-12 animate-on-scroll">
        <h3 class="font-heading text-2xl sm:text-3xl font-bold text-primary">Møt teamet vårt</h3>
        <p class="text-text-muted mt-2">Erfarne fagfolk som brenner for biler</p>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 stagger-children">
        {team.map((member) => (
          <div class="animate-on-scroll text-center group">
            <div class="w-24 h-24 mx-auto mb-4 bg-gradient-to-br from-primary/15 to-primary/5 rounded-full flex items-center justify-center border-2 border-border group-hover:border-accent transition-colors">
              <svg class="w-10 h-10 text-primary/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
              </svg>
            </div>
            <h4 class="font-heading font-bold text-primary">{member.name}</h4>
            <p class="text-text-muted text-sm">{member.role}</p>
            <p class="text-accent text-xs font-semibold mt-1">{member.years}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
