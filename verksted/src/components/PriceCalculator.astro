---
const brands = ['Toyota', 'Volkswagen', 'BMW', 'Mercedes', 'Audi', 'Volvo', 'Tesla', 'Hyundai', 'Kia', 'Skoda', 'Ford', 'Nissan', 'Mazda', 'Peugeot'];
const services = [
  { id: 'service-liten', name: 'Liten service', price: 3490 },
  { id: 'service-stor', name: 'Stor service', price: 5990 },
  { id: 'eu-kontroll', name: 'EU-kontroll', price: 1790 },
  { id: 'dekkskift', name: 'Dekkskift (4 hjul)', price: 890 },
  { id: 'hjulstilling', name: 'Hjulstilling', price: 1290 },
  { id: 'bremser-foran', name: 'Bremser foran (klosser + skiver)', price: 4490 },
  { id: 'bremser-bak', name: 'Bremser bak (klosser + skiver)', price: 3990 },
  { id: 'ac-service', name: 'AC-service & påfylling', price: 1490 },
  { id: 'diagnostikk', name: 'Diagnostikk / feilsøking', price: 990 },
  { id: 'olje-filter', name: 'Oljeskift + filter', price: 1990 },
];
---

<section id="priser" class="py-20 sm:py-28 bg-surface">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-16 animate-on-scroll">
      <span class="inline-block text-accent font-semibold text-sm tracking-wider uppercase mb-3">Priskalkulator</span>
      <h2 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-bold text-primary mb-4">
        Få et prisestimat med en gang
      </h2>
      <p class="text-text-muted text-lg">
        Velg bilmerke og tjenester for å se veiledende priser. Ingen overraskelser.
      </p>
    </div>

    <div class="max-w-3xl mx-auto animate-on-scroll scale-in">
      <div class="bg-white rounded-2xl border border-border shadow-lg overflow-hidden">
        <!-- Car Selection -->
        <div class="p-6 sm:p-8 border-b border-border">
          <label class="block font-heading font-semibold text-primary mb-3">
            <span class="flex items-center gap-2">
              <svg class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" />
              </svg>
              Velg bilmerke
            </span>
          </label>
          <select id="calc-brand" class="w-full px-4 py-3 rounded-xl border border-border bg-surface text-text focus:outline-none focus:ring-2 focus:ring-accent/30 focus:border-accent transition-all font-medium">
            <option value="">— Velg bilmerke —</option>
            {brands.map((brand) => (
              <option value={brand}>{brand}</option>
            ))}
          </select>
        </div>

        <!-- Services Selection -->
        <div class="p-6 sm:p-8 border-b border-border">
          <label class="block font-heading font-semibold text-primary mb-4">
            <span class="flex items-center gap-2">
              <svg class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              Velg tjeneste(r)
            </span>
          </label>
          <div class="grid sm:grid-cols-2 gap-3">
            {services.map((service) => (
              <label class="calc-service flex items-center gap-3 p-3 rounded-xl border border-border hover:border-accent/30 hover:bg-accent/5 cursor-pointer transition-all group" data-price={service.price}>
                <input type="checkbox" name="service" value={service.id} class="w-5 h-5 rounded-md border-border text-accent focus:ring-accent/30 accent-accent" />
                <div class="flex-1 min-w-0">
                  <span class="block text-sm font-medium text-text group-hover:text-primary transition-colors">{service.name}</span>
                  <span class="text-xs text-text-muted">fra kr {service.price.toLocaleString('nb-NO')},-</span>
                </div>
              </label>
            ))}
          </div>
        </div>

        <!-- Price Display -->
        <div class="p-6 sm:p-8 bg-primary/[0.02]">
          <div class="flex items-center justify-between mb-4">
            <span class="font-heading font-semibold text-primary">Estimert totalpris:</span>
            <div class="text-right">
              <span id="calc-total" class="font-heading font-extrabold text-3xl sm:text-4xl text-accent">kr 0,-</span>
            </div>
          </div>
          <p class="text-text-muted text-xs mb-5">
            * Veiledende priser inkl. mva. Endelig pris avtales ved verkstedet basert på bilmodell og tilstand.
          </p>
          <a href="#booking" id="calc-book-btn" class="block text-center bg-accent hover:bg-accent-hover text-white font-bold px-8 py-4 rounded-xl transition-all btn-shine opacity-50 pointer-events-none">
            Bestill denne servicen
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
