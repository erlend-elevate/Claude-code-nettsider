---
const stats = [
  { value: '15', suffix: '+', label: 'Års erfaring', icon: '🏆' },
  { value: '1000', suffix: '+', label: 'Fornøyde kunder', icon: '👥' },
  { value: '4.9', suffix: '★', label: 'Google-vurdering', icon: '⭐' },
  { value: '8', suffix: '', label: 'Sertifiserte mekanikere', icon: '🔧' },
];
---

<section class="py-16 sm:py-20 bg-surface relative -mt-1">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8 stagger-children">
      {stats.map((stat) => (
        <div class="animate-on-scroll text-center p-6 sm:p-8 bg-white rounded-2xl shadow-sm border border-border hover:shadow-md transition-shadow">
          <div class="text-3xl mb-3">{stat.icon}</div>
          <div class="flex items-baseline justify-center gap-1">
            <span class="font-heading font-extrabold text-3xl sm:text-4xl lg:text-5xl text-primary counter" data-target={stat.value}>
              0
            </span>
            <span class="font-heading font-bold text-xl sm:text-2xl text-accent">{stat.suffix}</span>
          </div>
          <p class="text-text-muted text-sm sm:text-base mt-2 font-medium">{stat.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
