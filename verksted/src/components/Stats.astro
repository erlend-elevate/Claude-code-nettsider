---
const stats = [
  { value: '15', suffix: '+', label: 'Års erfaring', icon: '🏆' },
  { value: '1000', suffix: '+', label: 'Fornøyde kunder', icon: '👥' },
  { value: '4.9', suffix: '★', label: 'Google-vurdering', icon: '⭐' },
  { value: '8', suffix: '', label: 'Sertifiserte mekanikere', icon: '🔧' },
];
---

<section class="py-16 sm:py-20 bg-surface relative -mt-1">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-6 stagger-children">
      {stats.map((stat) => (
        <div class="animate-on-scroll group text-center p-6 sm:p-8 bg-white rounded-2xl border border-border relative overflow-hidden transition-all duration-300 hover:shadow-lg hover:shadow-primary/[0.06] hover:-translate-y-1">
          <!-- Subtle gradient accent on top -->
          <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-primary via-accent to-primary opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
          <div class="text-3xl mb-3 transition-transform duration-300 group-hover:scale-110">{stat.icon}</div>
          <div class="flex items-baseline justify-center gap-1">
            <span class="font-heading font-extrabold text-3xl sm:text-4xl lg:text-5xl text-primary counter" data-target={stat.value}>
              0
            </span>
            <span class="font-heading font-bold text-xl sm:text-2xl bg-gradient-to-r from-accent to-orange-400 bg-clip-text text-transparent">{stat.suffix}</span>
          </div>
          <p class="text-text-muted text-sm sm:text-base mt-2 font-medium">{stat.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
