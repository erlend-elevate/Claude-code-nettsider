---

<section id="tjenester" class="py-20 sm:py-28 bg-surface">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-16 animate-on-scroll">
      <span class="inline-block text-accent font-semibold text-sm tracking-wider uppercase mb-3">Våre tjenester</span>
      <h2 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-bold text-primary mb-4">
        Alt for din bil — under ett tak
      </h2>
      <p class="text-text-muted text-lg">
        Fra enkel service til avansert diagnostikk. Våre sertifiserte mekanikere hjelper deg med alt.
      </p>
    </div>

    <!-- Service Cards -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 stagger-children">
      {services.map((service) => (
        <div class="animate-on-scroll card-hover group bg-white rounded-2xl p-6 border border-border cursor-pointer">
          <div class="w-14 h-14 bg-primary/5 group-hover:bg-accent/10 rounded-xl flex items-center justify-center text-primary group-hover:text-accent transition-colors mb-5">
            <Fragment set:html={service.icon} />
          </div>
          <h3 class="font-heading font-bold text-lg text-primary mb-2 group-hover:text-accent transition-colors">
            {service.title}
          </h3>
          <p class="text-text-muted text-sm leading-relaxed">
            {service.description}
          </p>
          <div class="mt-4 flex items-center gap-1 text-accent text-sm font-semibold opacity-0 group-hover:opacity-100 transition-opacity">
            Les mer
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
