---
const quickLinks = [
  { href: '#tjenester', label: 'Tjenester' },
  { href: '#priser', label: 'Priser' },
  { href: '#booking', label: 'Bestill time' },
  { href: '#galleri', label: 'Galleri' },
  { href: '#anmeldelser', label: 'Anmeldelser' },
  { href: '#faq', label: 'FAQ' },
];

const serviceLinks = [
  'Service & vedlikehold',
  'EU-kontroll',
  'Dekkskift',
  'Bremser',
  'Klimaanlegg',
  'Elbil-service',
];
---

<footer class="bg-primary-dark text-white pt-16 pb-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-8 pb-12 border-b border-white/10">
      <!-- Brand -->
      <div class="sm:col-span-2 lg:col-span-1">
        <a href="#" class="flex items-center gap-2 mb-4">
          <div class="w-10 h-10 bg-accent rounded-lg flex items-center justify-center text-white font-bold">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085" />
            </svg>
          </div>
          <div>
            <span class="font-heading font-bold text-lg leading-tight block">Motorverk</span>
            <span class="text-white/50 text-xs tracking-wider uppercase">Bergen</span>
          </div>
        </a>
        <p class="text-white/50 text-sm leading-relaxed mb-5 max-w-xs">
          Autorisert bilverksted i Bergen siden 2009. Service, EU-kontroll og reparasjon med kvalitet og tillit i fokus.
        </p>
        <!-- Certifications -->
        <div class="flex gap-2 flex-wrap">
          <span class="inline-flex items-center gap-1 bg-white/5 px-3 py-1.5 rounded-lg text-xs font-medium text-white/60 border border-white/10">
            🛡️ NAF-godkjent
          </span>
          <span class="inline-flex items-center gap-1 bg-white/5 px-3 py-1.5 rounded-lg text-xs font-medium text-white/60 border border-white/10">
            🌿 Miljøfyrtårn
          </span>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="font-heading font-semibold text-white mb-4">Hurtiglenker</h4>
        <ul class="space-y-2">
          {quickLinks.map((link) => (
            <li>
              <a href={link.href} class="text-white/50 hover:text-white text-sm transition-colors">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Services -->
      <div>
        <h4 class="font-heading font-semibold text-white mb-4">Tjenester</h4>
        <ul class="space-y-2">
          {serviceLinks.map((service) => (
            <li>
              <a href="#tjenester" class="text-white/50 hover:text-white text-sm transition-colors">{service}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="font-heading font-semibold text-white mb-4">Kontakt</h4>
        <ul class="space-y-3 text-sm">
          <li class="flex items-start gap-2 text-white/50">
            <svg class="w-4 h-4 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
            </svg>
            Kanalveien 42, 5068 Bergen
          </li>
          <li>
            <a href="tel:+4755123456" class="flex items-center gap-2 text-white/50 hover:text-white transition-colors">
              <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
              </svg>
              55 12 34 56
            </a>
          </li>
          <li>
            <a href="mailto:post@motorverkbergen.no" class="flex items-center gap-2 text-white/50 hover:text-white transition-colors">
              <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
              </svg>
              post@motorverkbergen.no
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-white/30 text-sm">&copy; 2025 Motorverk Bergen AS. Alle rettigheter reservert.</p>
      <div class="flex gap-6 text-white/30 text-sm">
        <a href="#" class="hover:text-white/60 transition-colors">Personvern</a>
        <a href="#" class="hover:text-white/60 transition-colors">Vilkår</a>
        <a href="#" class="hover:text-white/60 transition-colors">Cookies</a>
      </div>
    </div>
  </div>
</footer>
