---
const reviews = [
  {
    name: 'Anne-Kristin Larsen',
    car: 'Volvo XC60 2021',
    rating: 5,
    text: 'Fantastisk service! Leverte bilen til stor service og fikk den tilbake samme dag. Alt ble forklart grundig, og prisen ble nøyaktig som estimert. Anbefales på det varmeste.',
  },
  {
    name: 'Thomas Berge',
    car: 'Tesla Model 3 2022',
    rating: 5,
    text: 'Endelig et verksted i Bergen som virkelig kan elbiler! Profesjonelt utført og god kommunikasjon hele veien. Lånebil var klart da jeg kom — enkel og smidig opplevelse.',
  },
  {
    name: 'Ingrid Moen',
    car: 'BMW 3-serie 2019',
    rating: 5,
    text: 'Har brukt Motorverk Bergen i tre år nå. Alltid ærlige, dyktige og rimelige. De fant et problem en annen verksted hadde oversett. Sparret meg for en dyr reparasjon.',
  },
  {
    name: 'Kristoffer Dahl',
    car: 'Toyota RAV4 2020',
    rating: 5,
    text: 'EU-kontroll unnagjort på under en time! Super effektivt. Fikk en detaljert rapport og gode råd om forebyggende vedlikehold. Hyggelig og kompetent personale.',
  },
  {
    name: 'Linn Aksnes',
    car: 'Hyundai Ioniq 5 2023',
    rating: 5,
    text: 'Rask respons på booking, fleksible med tidspunkt, og grundig jobb. Satte pris på at de tok seg tid til å forklare hva som ble gjort og hvorfor. Kommer definitivt tilbake.',
  },
];
---

<section id="anmeldelser" class="py-20 sm:py-28 bg-surface">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-16 animate-on-scroll">
      <span class="inline-block text-accent font-semibold text-sm tracking-wider uppercase mb-3">Anmeldelser</span>
      <h2 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-bold text-primary mb-4">
        Hva kundene våre sier
      </h2>
      <p class="text-text-muted text-lg">
        4.9 av 5 stjerner basert på 200+ anmeldelser. Vi lar resultatene tale for seg.
      </p>
    </div>

    <!-- Carousel -->
    <div class="relative animate-on-scroll" id="testimonial-carousel">
      <div class="overflow-hidden rounded-2xl">
        <div class="carousel-track flex" id="carousel-track">
          {reviews.map((review) => (
            <div class="carousel-slide flex-shrink-0 w-full sm:w-1/2 lg:w-1/3 px-3">
              <div class="bg-white rounded-2xl p-6 sm:p-8 border border-border h-full flex flex-col relative overflow-hidden group hover:shadow-lg hover:shadow-primary/[0.05] transition-shadow duration-300">
                <!-- Gradient accent top -->
                <div class="absolute top-0 left-0 right-0 h-0.5 bg-gradient-to-r from-accent via-orange-400 to-accent"></div>
                <!-- Quote mark -->
                <div class="absolute top-4 right-5 text-5xl font-serif text-primary/[0.06] leading-none select-none">"</div>
                <!-- Stars -->
                <div class="flex gap-0.5 mb-4">
                  {Array.from({ length: review.rating }).map(() => (
                    <svg class="w-5 h-5 text-amber-400 drop-shadow-sm" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                  ))}
                </div>
                <!-- Review text -->
                <p class="text-text leading-relaxed flex-1 mb-6 text-sm sm:text-base relative z-10">
                  "{review.text}"
                </p>
                <!-- Reviewer -->
                <div class="flex items-center gap-3 pt-4 border-t border-border/60">
                  <div class="w-11 h-11 bg-gradient-to-br from-primary/15 to-primary/5 rounded-full flex items-center justify-center ring-2 ring-primary/10">
                    <span class="font-heading font-bold text-primary text-sm">
                      {review.name.split(' ').map(n => n[0]).join('')}
                    </span>
                  </div>
                  <div>
                    <p class="font-heading font-semibold text-primary text-sm">{review.name}</p>
                    <p class="text-text-muted text-xs">{review.car}</p>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Navigation -->
      <div class="flex items-center justify-center gap-4 mt-8">
        <button id="carousel-prev" class="p-3 rounded-full border border-border hover:border-primary hover:bg-primary hover:text-white text-text-muted transition-all">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
          </svg>
        </button>
        <div id="carousel-dots" class="flex gap-2">
          {reviews.map((_, i) => (
            <button class={`carousel-dot w-2.5 h-2.5 rounded-full transition-all ${i === 0 ? 'bg-accent w-8' : 'bg-border'}`} data-index={i}></button>
          ))}
        </div>
        <button id="carousel-next" class="p-3 rounded-full border border-border hover:border-primary hover:bg-primary hover:text-white text-text-muted transition-all">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>
