---
const trustItems = [
  { icon: '🏆', text: '15+ års erfaring' },
  { icon: '⭐', text: '4.9★ på Google' },
  { icon: '✅', text: 'Autorisert verksted' },
  { icon: '👥', text: '1000+ fornøyde kunder' },
];
---

<section id="hero" class="relative min-h-screen flex items-center overflow-hidden">
  <!-- Background -->
  <div class="absolute inset-0 bg-gradient-to-br from-primary-dark via-primary to-primary-dark">
    <!-- Decorative elements -->
    <div class="absolute inset-0 opacity-5">
      <div class="absolute top-20 right-20 w-96 h-96 rounded-full bg-accent blur-3xl"></div>
      <div class="absolute bottom-20 left-20 w-72 h-72 rounded-full bg-white blur-3xl"></div>
    </div>
    <!-- Grid pattern overlay -->
    <div class="absolute inset-0" style="background-image: radial-gradient(rgba(255,255,255,0.06) 1px, transparent 1px); background-size: 40px 40px;"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-32 lg:py-40">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Left: Content -->
      <div>
        <div class="hero-animate">
          <span class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm text-white/90 text-sm font-medium px-4 py-1.5 rounded-full border border-white/10 mb-6">
            <span class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></span>
            Åpent i dag: 07:00 – 17:00
          </span>
        </div>

        <h1 class="hero-animate font-heading text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white leading-tight mb-6">
          Ditt verksted i Bergen
          <span class="block text-accent">— siden 2009</span>
        </h1>

        <p class="hero-animate text-lg sm:text-xl text-white/70 max-w-lg mb-8 leading-relaxed">
          Autorisert service, EU-kontroll og reparasjon. Vi tar vare på bilen din med erfarne mekanikere og moderne utstyr.
        </p>

        <div class="hero-animate flex flex-col sm:flex-row gap-4 mb-10">
          <a href="#booking" class="inline-flex items-center justify-center gap-2 bg-accent hover:bg-accent-hover text-white font-bold px-8 py-4 rounded-xl text-lg transition-all btn-shine shadow-lg shadow-accent/25 hover:shadow-accent/40">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
            </svg>
            Bestill time online
          </a>
          <a href="#priser" class="inline-flex items-center justify-center gap-2 bg-white/10 hover:bg-white/15 backdrop-blur-sm text-white font-semibold px-8 py-4 rounded-xl text-lg transition-all border border-white/20">
            Se våre priser
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5L12 21m0 0l-7.5-7.5M12 21V3" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Right: Visual Element -->
      <div class="hero-animate hidden lg:block">
        <div class="relative">
          <!-- Main card -->
          <div class="bg-white/10 backdrop-blur-md rounded-2xl border border-white/15 p-8 shadow-2xl">
            <div class="aspect-[4/3] bg-gradient-to-br from-primary-light/30 to-primary-dark/50 rounded-xl flex items-center justify-center">
              <div class="text-center">
                <svg class="w-20 h-20 mx-auto text-white/40 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" />
                </svg>
                <p class="text-white/50 text-sm font-medium">Ditt bilde her</p>
              </div>
            </div>
          </div>
          <!-- Floating badge -->
          <div class="absolute -bottom-4 -left-4 bg-white rounded-xl shadow-xl p-4 flex items-center gap-3">
            <div class="w-10 h-10 bg-success/10 rounded-lg flex items-center justify-center">
              <svg class="w-5 h-5 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.745 3.745 0 011.043 3.296A3.745 3.745 0 0121 12z" />
              </svg>
            </div>
            <div>
              <p class="font-heading font-bold text-primary text-sm">NAF-godkjent</p>
              <p class="text-text-muted text-xs">Autorisert verksted</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Trust Bar -->
    <div class="hero-animate mt-16 pt-8 border-t border-white/10">
      <div class="flex flex-wrap justify-center lg:justify-start gap-6 sm:gap-10">
        {trustItems.map((item) => (
          <div class="flex items-center gap-2 text-white/70">
            <span class="text-lg">{item.icon}</span>
            <span class="text-sm font-medium">{item.text}</span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Bottom wave divider -->
  <div class="absolute bottom-0 left-0 right-0">
    <svg viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" class="w-full h-16 sm:h-20">
      <path d="M0 40C360 80 720 0 1080 40C1260 60 1380 60 1440 40V80H0V40Z" fill="var(--color-surface)" />
    </svg>
  </div>
</section>
