---
const trustItems = [
  { icon: '🏆', text: '15+ års erfaring' },
  { icon: '⭐', text: '4.9★ på Google' },
  { icon: '✅', text: 'Autorisert verksted' },
  { icon: '👥', text: '1000+ fornøyde kunder' },
];
---

<section id="hero" class="relative min-h-screen flex items-center overflow-hidden">
  <!-- Animated Background -->
  <div class="absolute inset-0 bg-gradient-to-br from-[#070d1a] via-primary-dark to-[#0a1628]">
    <!-- Animated gradient orbs -->
    <div class="absolute top-[-10%] right-[-5%] w-[600px] h-[600px] rounded-full bg-accent/15 blur-[120px] animate-orb-float"></div>
    <div class="absolute bottom-[-15%] left-[-10%] w-[500px] h-[500px] rounded-full bg-primary-light/20 blur-[100px] animate-orb-float-reverse"></div>
    <div class="absolute top-[40%] left-[30%] w-[300px] h-[300px] rounded-full bg-blue-500/10 blur-[80px] animate-orb-pulse"></div>
    <!-- Grid pattern overlay -->
    <div class="absolute inset-0" style="background-image: radial-gradient(rgba(255,255,255,0.04) 1px, transparent 1px); background-size: 48px 48px;"></div>
    <!-- Noise texture -->
    <div class="absolute inset-0 opacity-[0.015]" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 256 256%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noise%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.65%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noise)%22/%3E%3C/svg%3E');"></div>
    <!-- Gradient lines -->
    <div class="absolute top-0 left-1/4 w-px h-full bg-gradient-to-b from-transparent via-white/[0.06] to-transparent"></div>
    <div class="absolute top-0 left-2/4 w-px h-full bg-gradient-to-b from-transparent via-white/[0.04] to-transparent"></div>
    <div class="absolute top-0 left-3/4 w-px h-full bg-gradient-to-b from-transparent via-white/[0.06] to-transparent"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-32 lg:py-40">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
      <!-- Left: Content -->
      <div>
        <div class="hero-animate">
          <span class="inline-flex items-center gap-2 bg-white/[0.07] backdrop-blur-xl text-white/90 text-sm font-medium px-4 py-2 rounded-full border border-white/[0.08] mb-8 shadow-lg shadow-black/10">
            <span class="relative flex h-2.5 w-2.5">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-green-400"></span>
            </span>
            Åpent i dag: 07:00 – 17:00
          </span>
        </div>

        <h1 class="hero-animate font-heading text-5xl sm:text-6xl lg:text-7xl font-extrabold text-white leading-[1.08] mb-6 tracking-tight">
          Ditt verksted
          <br />i Bergen
          <span class="block mt-2 bg-gradient-to-r from-accent via-orange-400 to-accent bg-clip-text text-transparent">— siden 2009</span>
        </h1>

        <p class="hero-animate text-lg sm:text-xl text-white/60 max-w-lg mb-10 leading-relaxed">
          Autorisert service, EU-kontroll og reparasjon. Vi tar vare på bilen din med erfarne mekanikere og moderne utstyr.
        </p>

        <div class="hero-animate flex flex-col sm:flex-row gap-4 mb-12">
          <a href="#booking" class="group inline-flex items-center justify-center gap-2.5 bg-gradient-to-r from-accent to-orange-500 hover:from-accent-hover hover:to-orange-600 text-white font-bold px-8 py-4 rounded-xl text-lg transition-all btn-shine shadow-xl shadow-accent/20 hover:shadow-accent/35 hover:scale-[1.02] active:scale-[0.98]">
            <svg class="w-5 h-5 transition-transform group-hover:-translate-y-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
            </svg>
            Bestill time online
          </a>
          <a href="#priser" class="group inline-flex items-center justify-center gap-2.5 bg-white/[0.06] hover:bg-white/[0.1] backdrop-blur-xl text-white font-semibold px-8 py-4 rounded-xl text-lg transition-all border border-white/[0.1] hover:border-white/[0.2]">
            Se våre priser
            <svg class="w-5 h-5 transition-transform group-hover:translate-y-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5L12 21m0 0l-7.5-7.5M12 21V3" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Right: Premium Visual Element -->
      <div class="hero-animate hidden lg:block">
        <div class="relative">
          <!-- Glow effect behind card -->
          <div class="absolute -inset-4 bg-gradient-to-br from-accent/20 via-transparent to-primary-light/20 rounded-3xl blur-2xl opacity-60"></div>

          <!-- Main glassmorphism card -->
          <div class="relative bg-white/[0.07] backdrop-blur-2xl rounded-2xl border border-white/[0.1] p-1.5 shadow-2xl shadow-black/20">
            <div class="bg-gradient-to-br from-white/[0.05] to-transparent rounded-xl p-7">
              <div class="aspect-[4/3] bg-gradient-to-br from-primary/40 to-primary-dark/60 rounded-lg flex items-center justify-center relative overflow-hidden">
                <!-- Subtle animated gradient inside -->
                <div class="absolute inset-0 bg-gradient-to-tr from-accent/5 to-transparent animate-gradient-shift"></div>
                <div class="text-center relative z-10">
                  <svg class="w-20 h-20 mx-auto text-white/30 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="0.75">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" />
                  </svg>
                  <p class="text-white/40 text-sm font-medium">Ditt bilde her</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Floating badge: NAF-godkjent -->
          <div class="absolute -bottom-5 -left-5 bg-white/95 backdrop-blur-lg rounded-xl shadow-2xl shadow-black/15 p-4 flex items-center gap-3 border border-white/50 animate-float">
            <div class="w-11 h-11 bg-gradient-to-br from-success/20 to-success/5 rounded-lg flex items-center justify-center">
              <svg class="w-5 h-5 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.745 3.745 0 011.043 3.296A3.745 3.745 0 0121 12z" />
              </svg>
            </div>
            <div>
              <p class="font-heading font-bold text-primary text-sm">NAF-godkjent</p>
              <p class="text-text-muted text-xs">Autorisert verksted</p>
            </div>
          </div>

          <!-- Floating badge: Rating -->
          <div class="absolute -top-3 -right-3 bg-white/95 backdrop-blur-lg rounded-xl shadow-2xl shadow-black/15 px-4 py-3 border border-white/50 animate-float-delayed">
            <div class="flex items-center gap-1.5">
              <div class="flex gap-0.5">
                {[1,2,3,4,5].map(() => (
                  <svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                ))}
              </div>
              <span class="font-heading font-bold text-primary text-sm">4.9</span>
            </div>
            <p class="text-text-muted text-xs mt-0.5">200+ anmeldelser</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Trust Bar -->
    <div class="hero-animate mt-16 pt-8 border-t border-white/[0.06]">
      <div class="flex flex-wrap justify-center lg:justify-start gap-4 sm:gap-6">
        {trustItems.map((item) => (
          <div class="flex items-center gap-2.5 bg-white/[0.04] backdrop-blur-sm px-5 py-2.5 rounded-full border border-white/[0.06]">
            <span class="text-base">{item.icon}</span>
            <span class="text-sm font-medium text-white/70">{item.text}</span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Bottom wave divider -->
  <div class="absolute bottom-0 left-0 right-0">
    <svg viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" class="w-full h-16 sm:h-24">
      <path d="M0 40C360 80 720 0 1080 40C1260 60 1380 60 1440 40V80H0V40Z" fill="var(--color-surface)" />
    </svg>
  </div>
</section>
