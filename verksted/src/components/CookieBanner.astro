<div id="cookie-banner" class="fixed bottom-0 left-0 right-0 z-40 transform translate-y-full transition-transform duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-4">
    <div class="bg-primary-dark border border-white/10 rounded-2xl p-5 sm:p-6 shadow-2xl flex flex-col sm:flex-row items-start sm:items-center gap-4">
      <div class="flex-1">
        <p class="text-white/90 text-sm font-medium mb-1">Vi bruker informasjonskapsler</p>
        <p class="text-white/50 text-xs leading-relaxed">
          Vi bruker informasjonskapsler for å forbedre din opplevelse på nettsiden. Ved å fortsette godtar du vår bruk av cookies.
          <a href="#" class="text-accent hover:underline">Les mer</a>
        </p>
      </div>
      <div class="flex gap-2 flex-shrink-0">
        <button id="cookie-decline" class="px-4 py-2 text-white/60 hover:text-white text-sm font-medium transition-colors">
          Avslå
        </button>
        <button id="cookie-accept" class="px-5 py-2 bg-accent hover:bg-accent-hover text-white text-sm font-semibold rounded-lg transition-colors">
          Godta
        </button>
      </div>
    </div>
  </div>
</div>
