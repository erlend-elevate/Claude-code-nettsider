---
const categories = ['Alle', 'Verksted', 'Biler', 'Team'];
const images = [
  { category: 'Verksted', label: 'Moderne verkstedhall', aspect: '4/3' },
  { category: 'Biler', label: 'Kundens BMW i service', aspect: '3/4' },
  { category: 'Team', label: 'Teamet i arbeid', aspect: '4/3' },
  { category: 'Verksted', label: 'Diagnostikkutstyr', aspect: '1/1' },
  { category: 'Biler', label: 'Elbil-service', aspect: '4/3' },
  { category: 'Team', label: 'Erik og Marte', aspect: '3/4' },
  { category: 'Verksted', label: 'Dekkhotell', aspect: '4/3' },
  { category: 'Biler', label: 'EU-kontroll', aspect: '1/1' },
];
---

<section id="galleri" class="py-20 sm:py-28 bg-surface-alt">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-12 animate-on-scroll">
      <span class="inline-block text-accent font-semibold text-sm tracking-wider uppercase mb-3">Galleri</span>
      <h2 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-bold text-primary mb-4">
        Se verkstedet vårt
      </h2>
      <p class="text-text-muted text-lg">
        Moderne fasiliteter og dedikerte fagfolk. Ta en titt bak kulissene.
      </p>
    </div>

    <!-- Category Filter -->
    <div class="flex justify-center gap-2 mb-10 animate-on-scroll">
      {categories.map((cat, i) => (
        <button
          class={`gallery-filter px-5 py-2 rounded-full text-sm font-medium transition-all ${i === 0 ? 'bg-primary text-white' : 'bg-white text-text-muted hover:text-primary border border-border'}`}
          data-filter={cat === 'Alle' ? 'all' : cat}
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- Image Grid -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 stagger-children" id="gallery-grid">
      {images.map((img, idx) => (
        <div
          class="animate-on-scroll gallery-item group cursor-pointer overflow-hidden rounded-xl border border-border"
          data-category={img.category}
          data-index={idx}
        >
          <div class={`aspect-[${img.aspect}] bg-gradient-to-br from-primary/10 to-primary/5 relative`}>
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="text-center">
                <svg class="w-10 h-10 mx-auto text-primary/25 mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0022.5 18.75V5.25A2.25 2.25 0 0020.25 3H3.75A2.25 2.25 0 001.5 5.25v13.5A2.25 2.25 0 003.75 21z" />
                </svg>
                <p class="text-primary/30 text-xs">{img.label}</p>
              </div>
            </div>
            <!-- Hover overlay -->
            <div class="absolute inset-0 bg-primary/60 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
              <svg class="w-8 h-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607zM10.5 7.5v6m3-3h-6" />
              </svg>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Lightbox -->
  <div id="lightbox" class="lightbox-overlay fixed inset-0 z-50 bg-black/90 flex items-center justify-center">
    <button id="lightbox-close" class="absolute top-6 right-6 text-white/80 hover:text-white p-2 rounded-full hover:bg-white/10 transition-colors">
      <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    <button id="lightbox-prev" class="absolute left-4 sm:left-8 text-white/80 hover:text-white p-3 rounded-full hover:bg-white/10 transition-colors">
      <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
      </svg>
    </button>
    <button id="lightbox-next" class="absolute right-4 sm:right-8 text-white/80 hover:text-white p-3 rounded-full hover:bg-white/10 transition-colors">
      <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
      </svg>
    </button>
    <div id="lightbox-content" class="max-w-4xl w-full mx-8">
      <div class="aspect-[16/10] bg-primary/20 rounded-xl flex items-center justify-center">
        <p id="lightbox-label" class="text-white/60 text-lg font-medium"></p>
      </div>
    </div>
  </div>
</section>
