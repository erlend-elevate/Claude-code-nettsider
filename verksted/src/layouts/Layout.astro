---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Motorverk Bergen — Autorisert Bilverksted i Bergen',
  description = 'Motorverk Bergen er ditt autoriserte bilverksted i Bergen. Service, EU-kontroll, dekkskift og reparasjon. Bestill time online — 15+ års erfaring, 4.9★ på Google.',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="nb">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0F2440" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;500;600;700;800&family=Source+Sans+3:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>
  <!-- Page Loader -->
  <div id="page-loader" class="page-loader">
    <div class="loader-brand">Motorverk Bergen</div>
    <div class="loader-spinner"></div>
  </div>

  <slot />

  <style is:global>
    @import '../styles/global.css';
  </style>
</body>
</html>
