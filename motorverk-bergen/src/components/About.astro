---
const certifications = [
  { name: 'NAF-godkjent', icon: '🛡️' },
  { name: 'Miljøfyrtårn', icon: '🌿' },
  { name: 'Autorisert', icon: '✅' },
  { name: 'Elbil-sertifisert', icon: '⚡' },
];

const stats = [
  { value: '15+', label: 'Års erfaring' },
  { value: '200+', label: 'Fornøyde kunder' },
  { value: '4.9', label: 'Google-vurdering' },
  { value: '8', label: 'Spesialister' },
];
---

<section id="om-oss" class="py-24 lg:py-32 bg-cream relative overflow-hidden">
  <div class="absolute bottom-0 left-0 w-80 h-80 bg-navy/5 rounded-full blur-3xl translate-y-1/2 -translate-x-1/2"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <!-- Image / Visual -->
      <div class="scroll-animate-left">
        <div class="relative">
          <div class="aspect-[4/3] bg-gradient-to-br from-navy to-navy-dark rounded-3xl overflow-hidden shadow-2xl">
            <!-- Placeholder for workshop image -->
            <div class="w-full h-full flex items-center justify-center">
              <div class="text-center text-white/60 p-8">
                <svg class="w-20 h-20 mx-auto mb-4 opacity-40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0022.5 18.75V5.25A2.25 2.25 0 0020.25 3H3.75A2.25 2.25 0 001.5 5.25v13.5A2.25 2.25 0 003.75 21z" />
                </svg>
                <p class="text-sm">Bilde av verkstedet kommer</p>
              </div>
            </div>
          </div>
          <!-- Floating card -->
          <div class="absolute -bottom-6 -right-6 glass-card rounded-2xl p-5 shadow-xl">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 bg-green/10 rounded-full flex items-center justify-center">
                <svg class="w-6 h-6 text-green" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                </svg>
              </div>
              <div>
                <div class="font-bold text-navy text-lg">15+ år</div>
                <div class="text-sm text-gray-500">i bransjen</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Text Content -->
      <div class="scroll-animate-right">
        <span class="inline-block px-4 py-1.5 bg-navy/10 text-navy font-semibold text-sm rounded-full mb-4">
          Om oss
        </span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-navy mb-6">
          Kvalitet og tillit
          <span class="gradient-text">siden 2009</span>
        </h2>
        <p class="text-lg text-gray-500 leading-relaxed mb-6">
          Motorverk Bergen ble grunnlagt med en enkel filosofi: ærlig og transparent bilservice til rettferdig pris. Vi er et uavhengig verksted som jobber med alle bilmerker.
        </p>
        <p class="text-lg text-gray-500 leading-relaxed mb-8">
          Vårt team på 8 sertifiserte teknikere holder seg oppdatert på den nyeste teknologien – fra tradisjonelle forbrenningsmotorer til elbiler og hybrider. Vi investerer kontinuerlig i moderne utstyr og opplæring.
        </p>

        <!-- Certifications -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-10">
          {certifications.map((cert) => (
            <div class="flex items-center gap-2 bg-white rounded-xl px-4 py-3 shadow-sm border border-gray-100">
              <span class="text-xl">{cert.icon}</span>
              <span class="text-sm font-semibold text-navy">{cert.name}</span>
            </div>
          ))}
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-4 gap-4">
          {stats.map((stat) => (
            <div class="text-center">
              <div class="text-2xl sm:text-3xl font-extrabold text-navy">{stat.value}</div>
              <div class="text-xs sm:text-sm text-gray-400 mt-1">{stat.label}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
