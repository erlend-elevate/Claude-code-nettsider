---
const certs = [
  { name: 'NAF-godkjent', desc: 'Kvalitetssikret av NAF' },
  { name: 'Miljøfyrtårn', desc: 'Sertifisert grønt verksted' },
  { name: 'Autorisert', desc: 'Offentlig autorisert bilverksted' },
  { name: 'Elbil-sertifisert', desc: 'Godkjent for høyvolt-arbeid' },
];
---

<section id="om-oss" class="py-24 bg-navy-dark relative overflow-hidden">
  <!-- Orbs -->
  <div class="orb w-80 h-80 bg-orange top-[-10%] right-[-5%]" style="animation-delay: 1s; opacity: 0.15;"></div>
  <div class="orb w-60 h-60 bg-navy-light bottom-[-10%] left-[10%]" style="animation-delay: 3s; opacity: 0.2;"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-6">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <!-- Left: Image placeholder -->
      <div class="reveal">
        <div class="relative">
          <div class="aspect-[4/3] rounded-3xl bg-navy-light/50 border border-white/10 flex items-center justify-center overflow-hidden">
            <div class="text-center p-8">
              <svg class="w-20 h-20 text-white/20 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0022.5 18.75V5.25A2.25 2.25 0 0020.25 3H3.75A2.25 2.25 0 001.5 5.25v13.5A2.25 2.25 0 003.75 21z" />
              </svg>
              <p class="text-white/30 text-sm">Bilde av verkstedet</p>
            </div>
          </div>
          <!-- Floating badge -->
          <div class="absolute -bottom-4 -right-4 glass-dark rounded-2xl p-4 shadow-2xl">
            <div class="text-center">
              <div class="text-3xl font-heading font-bold text-orange">15+</div>
              <div class="text-white/60 text-xs">Års erfaring</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Content -->
      <div class="reveal">
        <span class="inline-block bg-orange/10 text-orange font-heading font-semibold text-sm px-4 py-1.5 rounded-full mb-4">Om oss</span>
        <h2 class="font-heading font-bold text-3xl sm:text-4xl text-white mb-6">
          Pålitelig verksted siden 2009
        </h2>
        <p class="text-white/70 text-lg leading-relaxed mb-6">
          Motorverk Bergen ble grunnlagt med ett mål: å levere ærlig, kvalitetssikret bilservice til Bergens innbyggere. Med et team på 12 dyktige mekanikere dekker vi alt fra enkel oljebytte til avansert elbil-diagnostikk.
        </p>
        <p class="text-white/70 text-lg leading-relaxed mb-8">
          Vi investerer kontinuerlig i det nyeste utstyret og opplæring for å holde tritt med bilteknologiens raske utvikling. Ditt kjøretøy er i trygge hender hos oss.
        </p>

        <!-- Certifications -->
        <div class="grid grid-cols-2 gap-4">
          {certs.map(cert => (
            <div class="flex items-center gap-3 glass rounded-xl p-4 cursor-default">
              <svg class="w-6 h-6 text-green shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
              </svg>
              <div>
                <div class="text-white font-heading font-semibold text-sm">{cert.name}</div>
                <div class="text-white/50 text-xs">{cert.desc}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
