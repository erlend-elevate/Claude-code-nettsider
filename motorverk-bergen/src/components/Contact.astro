<section id="kontakt" class="py-24 bg-navy-dark relative overflow-hidden">
  <div class="orb w-96 h-96 bg-orange bottom-[-15%] right-[-10%]" style="animation-delay: 1.5s; opacity: 0.12;"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-6">
    <div class="text-center mb-12 reveal">
      <span class="inline-block bg-orange/10 text-orange font-heading font-semibold text-sm px-4 py-1.5 rounded-full mb-4">Kontakt</span>
      <h2 class="font-heading font-bold text-3xl sm:text-4xl lg:text-5xl text-white mb-4">
        Ta kontakt med oss
      </h2>
      <p class="text-white/60 text-lg max-w-2xl mx-auto">
        Vi svarer gjerne på spørsmål. Ring, send e-post eller besøk oss på Minde.
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-10">
      <!-- Contact info + Map -->
      <div class="reveal space-y-6">
        <!-- Info cards -->
        <div class="grid sm:grid-cols-2 gap-4">
          <a href="tel:55123456" class="glass rounded-2xl p-5 flex items-center gap-4 cursor-pointer hover:bg-white/15 transition-colors duration-200 group">
            <div class="w-12 h-12 bg-orange/20 rounded-xl flex items-center justify-center shrink-0">
              <svg class="w-6 h-6 text-orange" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
              </svg>
            </div>
            <div>
              <div class="text-white/50 text-xs mb-0.5">Telefon</div>
              <div class="text-white font-heading font-semibold group-hover:text-orange transition-colors duration-200">55 12 34 56</div>
            </div>
          </a>

          <a href="mailto:post@motorverkbergen.no" class="glass rounded-2xl p-5 flex items-center gap-4 cursor-pointer hover:bg-white/15 transition-colors duration-200 group">
            <div class="w-12 h-12 bg-orange/20 rounded-xl flex items-center justify-center shrink-0">
              <svg class="w-6 h-6 text-orange" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
              </svg>
            </div>
            <div>
              <div class="text-white/50 text-xs mb-0.5">E-post</div>
              <div class="text-white font-heading font-semibold text-sm group-hover:text-orange transition-colors duration-200">post@motorverkbergen.no</div>
            </div>
          </a>

          <div class="glass rounded-2xl p-5 flex items-center gap-4 cursor-default">
            <div class="w-12 h-12 bg-orange/20 rounded-xl flex items-center justify-center shrink-0">
              <svg class="w-6 h-6 text-orange" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
              </svg>
            </div>
            <div>
              <div class="text-white/50 text-xs mb-0.5">Adresse</div>
              <div class="text-white font-heading font-semibold text-sm">Kanalveien 42, 5068 Bergen</div>
            </div>
          </div>

          <div class="glass rounded-2xl p-5 flex items-center gap-4 cursor-default">
            <div class="w-12 h-12 bg-orange/20 rounded-xl flex items-center justify-center shrink-0">
              <svg class="w-6 h-6 text-orange" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <div class="text-white/50 text-xs mb-0.5">Åpningstider</div>
              <div class="text-white font-heading font-semibold text-sm">Man&ndash;fre 07:00&ndash;17:00</div>
            </div>
          </div>
        </div>

        <!-- Map placeholder -->
        <div class="aspect-video rounded-2xl bg-navy-light/50 border border-white/10 flex items-center justify-center overflow-hidden">
          <div class="text-center p-8">
            <svg class="w-16 h-16 text-white/15 mx-auto mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z" />
            </svg>
            <p class="text-white/30 text-sm">Kart – Kanalveien 42, Bergen</p>
            <p class="text-white/20 text-xs mt-1">Google Maps-innbygging legges til her</p>
          </div>
        </div>
      </div>

      <!-- Contact form -->
      <div class="reveal">
        <form id="contact-form" class="glass rounded-3xl p-8 space-y-5">
          <h3 class="font-heading font-semibold text-white text-xl mb-2">Send oss en melding</h3>
          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label for="contact-name" class="block text-white/60 text-sm mb-1.5">Navn</label>
              <input type="text" id="contact-name" required class="w-full px-4 py-3 rounded-xl bg-white/10 border border-white/10 text-white placeholder-white/30 focus-visible:ring-2 focus-visible:ring-orange focus-visible:outline-none transition-colors duration-200" placeholder="Ditt navn" />
            </div>
            <div>
              <label for="contact-phone" class="block text-white/60 text-sm mb-1.5">Telefon</label>
              <input type="tel" id="contact-phone" class="w-full px-4 py-3 rounded-xl bg-white/10 border border-white/10 text-white placeholder-white/30 focus-visible:ring-2 focus-visible:ring-orange focus-visible:outline-none transition-colors duration-200" placeholder="400 00 000" />
            </div>
          </div>
          <div>
            <label for="contact-email" class="block text-white/60 text-sm mb-1.5">E-post</label>
            <input type="email" id="contact-email" required class="w-full px-4 py-3 rounded-xl bg-white/10 border border-white/10 text-white placeholder-white/30 focus-visible:ring-2 focus-visible:ring-orange focus-visible:outline-none transition-colors duration-200" placeholder="din@epost.no" />
          </div>
          <div>
            <label for="contact-subject" class="block text-white/60 text-sm mb-1.5">Emne</label>
            <select id="contact-subject" class="w-full px-4 py-3 rounded-xl bg-white/10 border border-white/10 text-white focus-visible:ring-2 focus-visible:ring-orange focus-visible:outline-none transition-colors duration-200 cursor-pointer">
              <option value="general" class="text-text">Generell henvendelse</option>
              <option value="price" class="text-text">Pristilbud</option>
              <option value="complaint" class="text-text">Reklamasjon</option>
              <option value="business" class="text-text">Bedriftsavtale</option>
            </select>
          </div>
          <div>
            <label for="contact-message" class="block text-white/60 text-sm mb-1.5">Melding</label>
            <textarea id="contact-message" rows="4" required class="w-full px-4 py-3 rounded-xl bg-white/10 border border-white/10 text-white placeholder-white/30 focus-visible:ring-2 focus-visible:ring-orange focus-visible:outline-none transition-colors duration-200 resize-none" placeholder="Skriv din melding her..."></textarea>
          </div>
          <button type="submit" class="w-full bg-orange hover:bg-orange-dark text-white font-heading font-bold py-4 rounded-xl transition-colors duration-200 cursor-pointer shadow-lg shadow-orange/20">
            Send melding
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  document.getElementById('contact-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    btn.textContent = 'Sendt! Vi tar kontakt snart.';
    btn.disabled = true;
    btn.classList.add('opacity-70');
  });
</script>
