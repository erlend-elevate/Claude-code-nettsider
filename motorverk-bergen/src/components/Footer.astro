---
const currentYear = new Date().getFullYear();
---

<footer class="bg-navy text-white pt-16 pb-8 relative overflow-hidden">
  <div class="absolute top-0 left-1/4 w-64 h-64 bg-orange/5 rounded-full blur-3xl"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-10 mb-12">
      <!-- Brand -->
      <div class="sm:col-span-2 lg:col-span-1">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 bg-orange rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085" />
            </svg>
          </div>
          <div>
            <span class="text-lg font-bold">Motorverk</span>
            <span class="text-lg font-bold text-orange"> Bergen</span>
          </div>
        </div>
        <p class="text-white/50 text-sm leading-relaxed mb-4">
          Ditt pålitelige verksted på Minde. Eksperter på alle bilmerker, inkludert elbiler og hybrider.
        </p>
        <div class="flex gap-3">
          <div class="px-3 py-1 bg-white/10 rounded-lg text-xs text-white/60">NAF-godkjent</div>
          <div class="px-3 py-1 bg-white/10 rounded-lg text-xs text-white/60">Miljøfyrtårn</div>
        </div>
      </div>

      <!-- Tjenester -->
      <div>
        <h4 class="font-bold text-white mb-4">Tjenester</h4>
        <ul class="space-y-2 text-sm text-white/50">
          <li><a href="#tjenester" class="hover:text-orange transition-colors">Service & vedlikehold</a></li>
          <li><a href="#tjenester" class="hover:text-orange transition-colors">EU-kontroll</a></li>
          <li><a href="#tjenester" class="hover:text-orange transition-colors">Dekkskift & hjulstilling</a></li>
          <li><a href="#tjenester" class="hover:text-orange transition-colors">Bremser</a></li>
          <li><a href="#tjenester" class="hover:text-orange transition-colors">Elbil-service</a></li>
          <li><a href="#tjenester" class="hover:text-orange transition-colors">Lakk & karosseri</a></li>
        </ul>
      </div>

      <!-- Nyttige lenker -->
      <div>
        <h4 class="font-bold text-white mb-4">Nyttige lenker</h4>
        <ul class="space-y-2 text-sm text-white/50">
          <li><a href="#om-oss" class="hover:text-orange transition-colors">Om oss</a></li>
          <li><a href="#priser" class="hover:text-orange transition-colors">Priser</a></li>
          <li><a href="#booking" class="hover:text-orange transition-colors">Bestill time</a></li>
          <li><a href="#anmeldelser" class="hover:text-orange transition-colors">Anmeldelser</a></li>
          <li><a href="#faq" class="hover:text-orange transition-colors">FAQ</a></li>
          <li><a href="#kontakt" class="hover:text-orange transition-colors">Kontakt</a></li>
        </ul>
      </div>

      <!-- Kontakt -->
      <div>
        <h4 class="font-bold text-white mb-4">Kontakt</h4>
        <ul class="space-y-3 text-sm text-white/50">
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-orange flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
            </svg>
            Kanalveien 42, 5068 Bergen
          </li>
          <li>
            <a href="tel:55123456" class="flex items-center gap-2 hover:text-orange transition-colors">
              <svg class="w-4 h-4 text-orange flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
              </svg>
              55 12 34 56
            </a>
          </li>
          <li>
            <a href="mailto:post@motorverkbergen.no" class="flex items-center gap-2 hover:text-orange transition-colors">
              <svg class="w-4 h-4 text-orange flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
              </svg>
              post@motorverkbergen.no
            </a>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-orange flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Man–fre: 07:00–17:00
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-white/10 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-white/30">
      <p>&copy; {currentYear} Motorverk Bergen. Alle rettigheter reservert.</p>
      <div class="flex gap-6">
        <a href="#" class="hover:text-white/60 transition-colors">Personvern</a>
        <a href="#" class="hover:text-white/60 transition-colors">Cookies</a>
        <a href="#" class="hover:text-white/60 transition-colors">Vilkår</a>
      </div>
    </div>
  </div>
</footer>
