---
const reviews = [
  {
    name: 'Erik Andersen',
    date: 'Mars 2026',
    rating: 5,
    text: 'Fantastisk service! Bilen ble levert tilbake i perfekt stand. Ærlige og transparente med priser. Anbefales på det sterkeste!',
    car: 'Tesla Model 3',
  },
  {
    name: 'Marte Johansen',
    date: 'Februar 2026',
    rating: 5,
    text: 'Endelig et verksted som forstår seg på elbiler. Grundig gjennomgang og god oppfølging. Kommer tilbake!',
    car: 'VW ID.4',
  },
  {
    name: 'Bjørn Olsen',
    date: 'Januar 2026',
    rating: 5,
    text: 'Tok EU-kontroll og service her. Raskt og profesjonelt. Fikk en detaljert rapport med bilder av alt som ble gjort.',
    car: 'Volvo XC60',
  },
  {
    name: 'Silje Berg',
    date: 'Desember 2025',
    rating: 5,
    text: 'Hyggelig kundemottak og dyktige mekanikere. Leverte bilen tilbake renere enn da den kom inn. Topp service!',
    car: 'Toyota RAV4 Hybrid',
  },
  {
    name: 'Thomas Haugen',
    date: 'November 2025',
    rating: 4,
    text: 'Effektivt dekkskift med dekkhotell. Veldig praktisk å slippe å lagre dekkene selv. Greit prisnivå.',
    car: 'BMW 3-serie',
  },
];

function renderStars(rating: number) {
  return Array.from({ length: 5 }, (_, i) => i < rating ? 'filled' : 'empty');
}
---

<section id="anmeldelser" class="py-24 lg:py-32 bg-gradient-to-br from-navy via-navy-dark to-navy relative overflow-hidden">
  <!-- Decorative orbs -->
  <div class="absolute top-20 right-20 w-64 h-64 bg-orange/10 rounded-full blur-3xl"></div>
  <div class="absolute bottom-20 left-20 w-48 h-48 bg-orange/5 rounded-full blur-3xl"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    <div class="text-center max-w-3xl mx-auto mb-16 scroll-animate">
      <span class="inline-block px-4 py-1.5 bg-white/10 text-orange font-semibold text-sm rounded-full mb-4">
        Anmeldelser
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white mb-6">
        Hva kundene sier
      </h2>
      <div class="flex items-center justify-center gap-3 mb-4">
        <div class="flex gap-1">
          {[1,2,3,4,5].map(() => (
            <svg class="w-6 h-6 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
          ))}
        </div>
        <span class="text-2xl font-bold text-white">4.9</span>
        <span class="text-white/50">basert på 200+ anmeldelser</span>
      </div>
    </div>

    <!-- Reviews Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 stagger-children">
      {reviews.map((review) => (
        <div class="glass rounded-2xl p-6 hover:bg-white/15 transition-all duration-300 hover:-translate-y-1">
          <div class="flex gap-1 mb-4">
            {renderStars(review.rating).map((star) => (
              <svg class={`w-5 h-5 ${star === 'filled' ? 'text-yellow-400' : 'text-white/20'}`} fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>
          <p class="text-white/80 leading-relaxed mb-4">{review.text}</p>
          <div class="flex items-center justify-between pt-4 border-t border-white/10">
            <div>
              <div class="font-semibold text-white">{review.name}</div>
              <div class="text-sm text-white/40">{review.car}</div>
            </div>
            <span class="text-xs text-white/30">{review.date}</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Google Review Link -->
    <div class="text-center mt-12 scroll-animate">
      <a href="#" class="inline-flex items-center gap-2 px-6 py-3 glass text-white font-semibold rounded-xl hover:bg-white/20 transition-all">
        Se alle anmeldelser på Google
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
        </svg>
      </a>
    </div>
  </div>
</section>
