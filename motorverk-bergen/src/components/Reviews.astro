---
const reviews = [
  {
    name: 'Kristine Haugen',
    date: 'Mars 2026',
    rating: 5,
    text: 'Fantastisk service! Bilen var klar før tiden, og prisen var akkurat som avtalt. Mekanikerne var hyggelige og forklarte hva de hadde gjort. Anbefales på det sterkeste!',
    car: 'Tesla Model 3',
  },
  {
    name: 'Erik Johansen',
    date: 'Februar 2026',
    rating: 5,
    text: 'Har brukt Motorverk Bergen i flere år nå. Alltid ærlig og grundig jobb. EU-kontrollen gikk smertefritt, og de fikset en liten ting på stedet uten ekstra kostnad.',
    car: 'Volvo XC60',
  },
  {
    name: 'Marte Olsen',
    date: 'Januar 2026',
    rating: 5,
    text: 'Eneste verkstedet i Bergen jeg stoler på med elbilen min. De er sertifiserte og vet hva de gjør. Batterisjekken ga meg trygghet for vinteren.',
    car: 'Volkswagen ID.4',
  },
  {
    name: 'Anders Berg',
    date: 'Desember 2025',
    rating: 5,
    text: 'Stor service på en gammel Passat. De fant et par ting som andre verksteder hadde oversett. Grundig arbeid og grei pris. Kjempefornøyd!',
    car: 'VW Passat',
  },
  {
    name: 'Silje Mathisen',
    date: 'November 2025',
    rating: 4,
    text: 'Veldig bra opplevelse med dekkskift. Rask og effektiv service, og de anbefalte nye dekk når det var på tide. Fin venteområde med kaffe også.',
    car: 'Toyota RAV4 Hybrid',
  },
];

const avgRating = (reviews.reduce((sum, r) => sum + r.rating, 0) / reviews.length).toFixed(1);
---

<section id="anmeldelser" class="py-24 bg-navy-dark relative overflow-hidden">
  <div class="orb w-72 h-72 bg-orange top-[20%] left-[-5%]" style="animation-delay: 2s; opacity: 0.12;"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-6">
    <div class="text-center mb-12 reveal">
      <span class="inline-block bg-orange/10 text-orange font-heading font-semibold text-sm px-4 py-1.5 rounded-full mb-4">Anmeldelser</span>
      <h2 class="font-heading font-bold text-3xl sm:text-4xl lg:text-5xl text-white mb-4">
        Hva kundene sier
      </h2>
      <div class="flex items-center justify-center gap-3 mt-4">
        <div class="flex items-center gap-1">
          {[1,2,3,4,5].map(() => (
            <svg class="w-6 h-6 text-orange" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
          ))}
        </div>
        <span class="text-white font-heading font-bold text-2xl">{avgRating}</span>
        <span class="text-white/50 text-sm">basert på 200+ anmeldelser</span>
      </div>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 stagger">
      {reviews.map((review, i) => (
        <div class:list={[
          "glass rounded-2xl p-6 cursor-default",
          i >= 3 && "hidden lg:block"
        ]}>
          <div class="flex items-center gap-1 mb-3">
            {Array.from({ length: review.rating }).map(() => (
              <svg class="w-4 h-4 text-orange" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>
          <p class="text-white/80 text-sm leading-relaxed mb-4">{review.text}</p>
          <div class="flex items-center justify-between pt-3 border-t border-white/10">
            <div>
              <div class="text-white font-heading font-semibold text-sm">{review.name}</div>
              <div class="text-white/40 text-xs">{review.car}</div>
            </div>
            <span class="text-white/30 text-xs">{review.date}</span>
          </div>
        </div>
      ))}
    </div>

    <div class="text-center mt-10 reveal">
      <a href="https://g.page/motorverk-bergen/review" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-orange hover:text-orange-light font-heading font-semibold text-sm transition-colors duration-200 cursor-pointer">
        Se alle anmeldelser på Google
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
        </svg>
      </a>
    </div>
  </div>
</section>
