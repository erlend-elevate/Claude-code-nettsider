---
const navLinks = [
  { href: '#tjenester', label: 'Tjenester' },
  { href: '#om-oss', label: 'Om oss' },
  { href: '#priser', label: 'Priser' },
  { href: '#galleri', label: 'Galleri' },
  { href: '#anmeldelser', label: 'Anmeldelser' },
  { href: '#booking', label: 'Bestill time' },
  { href: '#faq', label: 'FAQ' },
  { href: '#kontakt', label: 'Kontakt' },
];
---

<header id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href="#" class="flex items-center gap-3 group">
        <div class="w-10 h-10 bg-orange rounded-xl flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
          <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085" />
          </svg>
        </div>
        <div>
          <span class="text-lg font-bold font-heading text-navy">Motorverk</span>
          <span class="text-lg font-bold font-heading text-orange"> Bergen</span>
        </div>
      </a>

      <!-- Desktop Nav -->
      <div class="hidden lg:flex items-center gap-1">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="px-3 py-2 text-sm font-medium text-gray-600 hover:text-orange rounded-lg transition-colors"
          >
            {link.label}
          </a>
        ))}
        <a
          href="#booking"
          class="ml-4 px-5 py-2.5 bg-orange text-white text-sm font-semibold rounded-xl hover:bg-orange-dark transition-all shadow-lg shadow-orange/25 hover:shadow-orange/40 hover:-translate-y-0.5"
        >
          Bestill time
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden p-2 rounded-xl text-gray-600 hover:bg-gray-100 transition-colors"
        aria-label="Åpne meny"
      >
        <svg class="w-6 h-6 menu-open" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
        <svg class="w-6 h-6 menu-close hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="lg:hidden hidden">
    <div class="glass-dark mx-4 mb-4 rounded-2xl p-6 shadow-2xl">
      <div class="flex flex-col gap-2">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="mobile-nav-link px-4 py-3 text-white/80 hover:text-white hover:bg-white/10 rounded-xl transition-all font-medium"
          >
            {link.label}
          </a>
        ))}
        <a
          href="#booking"
          class="mobile-nav-link mt-2 px-4 py-3 bg-orange text-white text-center font-semibold rounded-xl hover:bg-orange-dark transition-colors"
        >
          Bestill time nå
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  // Navbar scroll effect
  const navbar = document.getElementById('navbar');
  let lastScroll = 0;

  window.addEventListener('scroll', () => {
    const currentScroll = window.scrollY;

    if (currentScroll > 80) {
      navbar?.classList.add('bg-white/90', 'backdrop-blur-xl', 'shadow-lg', 'shadow-navy/5');
    } else {
      navbar?.classList.remove('bg-white/90', 'backdrop-blur-xl', 'shadow-lg', 'shadow-navy/5');
    }

    lastScroll = currentScroll;
  });

  // Mobile menu toggle
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuOpen = menuBtn?.querySelector('.menu-open');
  const menuClose = menuBtn?.querySelector('.menu-close');

  menuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
    menuOpen?.classList.toggle('hidden');
    menuClose?.classList.toggle('hidden');
  });

  // Close mobile menu on link click
  document.querySelectorAll('.mobile-nav-link').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      menuOpen?.classList.remove('hidden');
      menuClose?.classList.add('hidden');
    });
  });
</script>
