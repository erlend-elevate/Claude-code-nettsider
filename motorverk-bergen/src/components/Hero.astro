---
---

<section id="hero" class="relative min-h-screen flex items-center overflow-hidden bg-gradient-to-br from-navy via-navy-dark to-navy">
  <!-- Animated Orbs -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute -top-20 -left-20 w-96 h-96 bg-orange/20 rounded-full blur-3xl animate-float"></div>
    <div class="absolute top-1/3 right-0 w-80 h-80 bg-orange/10 rounded-full blur-3xl animate-float-delay"></div>
    <div class="absolute bottom-0 left-1/3 w-72 h-72 bg-navy-light/30 rounded-full blur-3xl animate-pulse-glow"></div>
    <div class="absolute top-1/4 left-1/2 w-40 h-40 bg-orange/15 rounded-full blur-2xl animate-float"></div>
  </div>

  <!-- Grid Pattern Overlay -->
  <div class="absolute inset-0 opacity-5" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 40px 40px;"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-32 lg:py-40">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
      <!-- Text Content -->
      <div class="text-center lg:text-left">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-2 glass rounded-full mb-8 animate-fade-in">
          <span class="w-2 h-2 bg-green rounded-full animate-pulse"></span>
          <span class="text-sm text-white/80 font-medium">NAF-godkjent verksted</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-extrabold text-white leading-tight mb-6">
          Ditt verksted
          <span class="block gradient-text">i Bergen</span>
        </h1>

        <p class="text-lg sm:text-xl text-white/70 max-w-xl mx-auto lg:mx-0 mb-10 leading-relaxed">
          Eksperter på personbiler, elbiler og hybrider. Fra service og EU-kontroll til lakk og karosseri – alt under ett tak på Minde.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
          <a
            href="#booking"
            class="group px-8 py-4 bg-orange text-white font-bold rounded-2xl text-lg hover:bg-orange-dark transition-all shadow-2xl shadow-orange/30 hover:shadow-orange/50 hover:-translate-y-1 flex items-center justify-center gap-2"
          >
            Bestill time
            <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
          <a
            href="tel:55123456"
            class="px-8 py-4 glass text-white font-semibold rounded-2xl text-lg hover:bg-white/20 transition-all flex items-center justify-center gap-2"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
            </svg>
            55 12 34 56
          </a>
        </div>

        <!-- Trust Badges -->
        <div class="mt-12 flex flex-wrap gap-6 justify-center lg:justify-start">
          <div class="flex items-center gap-2 text-white/60 text-sm">
            <svg class="w-5 h-5 text-green" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
            </svg>
            NAF-godkjent
          </div>
          <div class="flex items-center gap-2 text-white/60 text-sm">
            <svg class="w-5 h-5 text-green" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
            </svg>
            Miljøfyrtårn
          </div>
          <div class="flex items-center gap-2 text-white/60 text-sm">
            <svg class="w-5 h-5 text-green" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
            </svg>
            Elbil-sertifisert
          </div>
        </div>
      </div>

      <!-- Hero Visual -->
      <div class="relative hidden lg:block">
        <div class="relative glass rounded-3xl p-8 shadow-2xl">
          <!-- Stats Cards -->
          <div class="grid grid-cols-2 gap-4">
            <div class="glass-card rounded-2xl p-6 text-center hover:scale-105 transition-transform">
              <div class="text-3xl font-extrabold text-navy mb-1">200+</div>
              <div class="text-sm text-gray-500">Fornøyde kunder</div>
            </div>
            <div class="glass-card rounded-2xl p-6 text-center hover:scale-105 transition-transform">
              <div class="text-3xl font-extrabold text-orange mb-1">4.9</div>
              <div class="text-sm text-gray-500">Google-vurdering</div>
            </div>
            <div class="glass-card rounded-2xl p-6 text-center hover:scale-105 transition-transform">
              <div class="text-3xl font-extrabold text-navy mb-1">15+</div>
              <div class="text-sm text-gray-500">Års erfaring</div>
            </div>
            <div class="glass-card rounded-2xl p-6 text-center hover:scale-105 transition-transform">
              <div class="text-3xl font-extrabold text-orange mb-1">8</div>
              <div class="text-sm text-gray-500">Spesialister</div>
            </div>
          </div>
        </div>

        <!-- Floating accent -->
        <div class="absolute -bottom-6 -right-6 w-24 h-24 bg-orange/20 rounded-full blur-xl animate-pulse-glow"></div>
      </div>
    </div>
  </div>

  <!-- Scroll Indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
    <svg class="w-6 h-6 text-white/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5L12 21m0 0l-7.5-7.5M12 21V3" />
    </svg>
  </div>
</section>
