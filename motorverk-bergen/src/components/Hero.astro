<section id="hjem" class="relative min-h-screen flex items-center overflow-hidden bg-navy-dark">
  <!-- Animated orbs -->
  <div class="orb w-96 h-96 bg-orange top-[-10%] left-[-5%]" style="animation-delay: 0s;"></div>
  <div class="orb w-80 h-80 bg-navy-light bottom-[-10%] right-[-5%]" style="animation-delay: 2s;"></div>
  <div class="orb w-64 h-64 bg-orange-light top-[40%] right-[20%]" style="animation-delay: 4s; opacity: 0.15;"></div>

  <!-- Grid pattern overlay -->
  <div class="absolute inset-0 opacity-5" style="background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,0.3) 1px, transparent 0); background-size: 40px 40px;"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-6 py-32 pt-40 w-full">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Left content -->
      <div class="reveal">
        <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm rounded-full px-4 py-2 mb-6 border border-white/10">
          <span class="w-2 h-2 bg-green rounded-full animate-pulse"></span>
          <span class="text-white/80 text-sm font-medium">Ledig kapasitet denne uken</span>
        </div>

        <h1 class="font-heading font-extrabold text-4xl sm:text-5xl lg:text-6xl text-white leading-tight mb-6">
          Ditt bilverksted
          <span class="gradient-text block">i Bergen</span>
        </h1>

        <p class="text-white/70 text-lg sm:text-xl max-w-xl mb-8 leading-relaxed">
          NAF-godkjent verksted med over 15 års erfaring. Vi tar vare på din bil &ndash; enten den er bensin, diesel, hybrid eller helelektrisk.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 mb-12">
          <a href="#booking" class="inline-flex items-center justify-center gap-2 bg-orange hover:bg-orange-dark text-white font-heading font-bold text-lg px-8 py-4 rounded-2xl transition-all duration-200 cursor-pointer shadow-lg shadow-orange/25 hover:shadow-orange/40 hover:-translate-y-0.5">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
            </svg>
            Bestill time online
          </a>
          <a href="tel:55123456" class="inline-flex items-center justify-center gap-2 bg-white/10 hover:bg-white/15 text-white font-heading font-semibold text-lg px-8 py-4 rounded-2xl transition-all duration-200 cursor-pointer border border-white/15">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
            </svg>
            Ring 55 12 34 56
          </a>
        </div>

        <!-- Trust badges -->
        <div class="flex flex-wrap gap-6 items-center">
          <div class="flex items-center gap-2 text-white/60 text-sm">
            <svg class="w-5 h-5 text-green" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
            </svg>
            NAF-godkjent
          </div>
          <div class="flex items-center gap-2 text-white/60 text-sm">
            <svg class="w-5 h-5 text-green" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
            </svg>
            Miljøfyrtårn
          </div>
          <div class="flex items-center gap-2 text-white/60 text-sm">
            <svg class="w-5 h-5 text-green" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
            </svg>
            Elbil-sertifisert
          </div>
        </div>
      </div>

      <!-- Right: Stats card -->
      <div class="reveal hidden lg:block">
        <div class="relative">
          <div class="glass rounded-3xl p-8 border border-white/10">
            <div class="grid grid-cols-2 gap-6">
              <div class="text-center p-4">
                <div class="text-4xl font-heading font-bold text-orange mb-1">15+</div>
                <div class="text-white/60 text-sm">Års erfaring</div>
              </div>
              <div class="text-center p-4">
                <div class="text-4xl font-heading font-bold text-orange mb-1">4.9</div>
                <div class="text-white/60 text-sm">Google-vurdering</div>
              </div>
              <div class="text-center p-4">
                <div class="text-4xl font-heading font-bold text-orange mb-1">200+</div>
                <div class="text-white/60 text-sm">Anmeldelser</div>
              </div>
              <div class="text-center p-4">
                <div class="text-4xl font-heading font-bold text-orange mb-1">12</div>
                <div class="text-white/60 text-sm">Ansatte</div>
              </div>
            </div>
            <div class="mt-6 pt-6 border-t border-white/10 flex items-center gap-3">
              <div class="w-12 h-12 rounded-full bg-white/10 flex items-center justify-center">
                <svg class="w-6 h-6 text-orange" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <div class="text-white font-medium text-sm">Åpningstider</div>
                <div class="text-white/50 text-sm">Man&ndash;fre 07:00&ndash;17:00</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 motion-reduce:hidden">
    <span class="text-white/40 text-xs uppercase tracking-widest">Scroll</span>
    <div class="w-6 h-10 rounded-full border-2 border-white/20 flex justify-center pt-2">
      <div class="w-1.5 h-1.5 bg-orange rounded-full animate-bounce"></div>
    </div>
  </div>
</section>
