---

<section id="tjenester" class="py-24 bg-cream relative">
  <div class="max-w-7xl mx-auto px-6">
    <!-- Section header -->
    <div class="text-center mb-16 reveal">
      <span class="inline-block bg-orange/10 text-orange font-heading font-semibold text-sm px-4 py-1.5 rounded-full mb-4">Våre tjenester</span>
      <h2 class="font-heading font-bold text-3xl sm:text-4xl lg:text-5xl text-navy mb-4">
        Alt ditt kjøretøy trenger
      </h2>
      <p class="text-muted text-lg max-w-2xl mx-auto">
        Fra enkel service til kompleks diagnostikk &ndash; vi har spesialistene og utstyret.
      </p>
    </div>

    <!-- Service cards -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 stagger">
      {services.map((service) => (
        <div class="group bg-white rounded-2xl p-6 shadow-sm hover:shadow-xl border border-border hover:border-orange/30 transition-all duration-300 cursor-pointer hover:-translate-y-1">
          <div class="w-14 h-14 bg-navy/5 group-hover:bg-orange/10 rounded-2xl flex items-center justify-center mb-5 transition-colors duration-300">
            <svg class="w-7 h-7 text-navy group-hover:text-orange transition-colors duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" set:html={service.icon} />
          </div>
          <h3 class="font-heading font-semibold text-navy text-lg mb-2">{service.title}</h3>
          <p class="text-muted text-sm leading-relaxed">{service.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
