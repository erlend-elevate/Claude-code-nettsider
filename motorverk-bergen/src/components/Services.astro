---

<section id="tjenester" class="py-24 lg:py-32 bg-white relative overflow-hidden">
  <!-- Background decoration -->
  <div class="absolute top-0 right-0 w-96 h-96 bg-orange/5 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 scroll-animate">
      <span class="inline-block px-4 py-1.5 bg-orange/10 text-orange font-semibold text-sm rounded-full mb-4">
        Våre tjenester
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-navy mb-6">
        Alt ditt kjøretøy trenger
      </h2>
      <p class="text-lg text-gray-500 leading-relaxed">
        Fra rutineservice til avansert diagnostikk – vi har ekspertisen og utstyret for alle bilmerker, inkludert elbiler og hybrider.
      </p>
    </div>

    <!-- Services Grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 stagger-children">
      {services.map((service) => (
        <div class="group relative bg-cream/50 rounded-2xl p-6 hover:bg-white hover:shadow-xl hover:shadow-navy/5 transition-all duration-300 hover:-translate-y-1 border border-transparent hover:border-gray-100">
          <div class="w-12 h-12 bg-orange/10 rounded-xl flex items-center justify-center mb-4 group-hover:bg-orange group-hover:scale-110 transition-all duration-300">
            <svg class="w-6 h-6 text-orange group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <Fragment set:html={service.icon} />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-navy mb-2 group-hover:text-orange transition-colors">{service.title}</h3>
          <p class="text-sm text-gray-500 leading-relaxed">{service.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
