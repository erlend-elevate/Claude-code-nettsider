---
const serviceOptions = [
  'Service (liten)',
  'Service (stor)',
  'EU-kontroll',
  'Dekkskift',
  'Hjulstilling',
  'Bremser',
  'AC-service',
  'Diagnostikk',
  'Lakk & karosseri',
  'Elbil-service',
  'Annet',
];
---

<section id="booking" class="py-24 lg:py-32 bg-white relative overflow-hidden">
  <div class="absolute top-0 right-0 w-96 h-96 bg-orange/5 rounded-full blur-3xl -translate-y-1/2 translate-x-1/3"></div>
  <div class="absolute bottom-0 left-0 w-72 h-72 bg-navy/5 rounded-full blur-3xl translate-y-1/2 -translate-x-1/3"></div>

  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    <div class="text-center max-w-3xl mx-auto mb-16 scroll-animate">
      <span class="inline-block px-4 py-1.5 bg-orange/10 text-orange font-semibold text-sm rounded-full mb-4">
        Bestill time
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-navy mb-6">
        Book verkstedtime online
      </h2>
      <p class="text-lg text-gray-500 leading-relaxed">
        Fyll ut skjemaet under, så bekrefter vi timen din innen 2 timer i åpningstiden.
      </p>
    </div>

    <div class="scroll-animate">
      <!-- Step Indicators -->
      <div class="flex items-center justify-between mb-10 max-w-md mx-auto">
        {[1, 2, 3, 4].map((step) => (
          <div class="flex items-center">
            <div
              class={`booking-step-indicator w-10 h-10 rounded-full flex items-center justify-center font-bold text-sm transition-all ${step === 1 ? 'bg-orange text-white shadow-lg shadow-orange/30' : 'bg-gray-100 text-gray-400'}`}
              data-step={step}
            >
              {step}
            </div>
            {step < 4 && (
              <div class="w-12 sm:w-20 h-0.5 bg-gray-100 mx-1">
                <div class="booking-step-line h-full bg-orange transition-all duration-500" data-after-step={step} style="width: 0%"></div>
              </div>
            )}
          </div>
        ))}
      </div>

      <form id="booking-form" class="bg-cream/50 rounded-3xl p-6 sm:p-10 border border-gray-100 shadow-lg">
        <!-- Step 1: Tjeneste -->
        <div class="booking-step" data-step="1">
          <h3 class="text-xl font-bold text-navy mb-2">Velg tjeneste</h3>
          <p class="text-gray-500 mb-6">Hva trenger bilen din?</p>
          <div class="grid sm:grid-cols-2 gap-3">
            {serviceOptions.map((service) => (
              <label class="service-option flex items-center gap-3 p-4 bg-white rounded-xl cursor-pointer border-2 border-transparent hover:border-orange/30 transition-all">
                <input type="radio" name="service" value={service} class="w-5 h-5 text-orange accent-orange" required />
                <span class="font-medium text-gray-700">{service}</span>
              </label>
            ))}
          </div>
        </div>

        <!-- Step 2: Bilinformasjon -->
        <div class="booking-step hidden" data-step="2">
          <h3 class="text-xl font-bold text-navy mb-2">Bilinformasjon</h3>
          <p class="text-gray-500 mb-6">Fortell oss om bilen din</p>
          <div class="space-y-4">
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1.5">Registreringsnummer</label>
              <input type="text" name="regnr" placeholder="AB 12345" class="w-full px-4 py-3 bg-white rounded-xl border border-gray-200 focus:border-orange focus:ring-2 focus:ring-orange/20 outline-none transition-all text-lg font-mono uppercase" required />
            </div>
            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1.5">Bilmerke</label>
                <input type="text" name="car-brand" placeholder="F.eks. Toyota" class="w-full px-4 py-3 bg-white rounded-xl border border-gray-200 focus:border-orange focus:ring-2 focus:ring-orange/20 outline-none transition-all" required />
              </div>
              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1.5">Modell</label>
                <input type="text" name="car-model" placeholder="F.eks. RAV4" class="w-full px-4 py-3 bg-white rounded-xl border border-gray-200 focus:border-orange focus:ring-2 focus:ring-orange/20 outline-none transition-all" required />
              </div>
            </div>
            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1.5">Årsmodell</label>
                <input type="number" name="car-year" placeholder="2022" min="1990" max="2027" class="w-full px-4 py-3 bg-white rounded-xl border border-gray-200 focus:border-orange focus:ring-2 focus:ring-orange/20 outline-none transition-all" required />
              </div>
              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1.5">Drivstoff</label>
                <select name="fuel" class="w-full px-4 py-3 bg-white rounded-xl border border-gray-200 focus:border-orange focus:ring-2 focus:ring-orange/20 outline-none transition-all" required>
                  <option value="">Velg type</option>
                  <option value="bensin">Bensin</option>
                  <option value="diesel">Diesel</option>
                  <option value="elbil">Elbil</option>
                  <option value="hybrid">Hybrid</option>
                  <option value="plugin-hybrid">Plugin-hybrid</option>
                </select>
              </div>
            </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1.5">Beskrivelse (valgfritt)</label>
              <textarea name="description" rows="3" placeholder="Beskriv eventuelt problemet eller ønsket..." class="w-full px-4 py-3 bg-white rounded-xl border border-gray-200 focus:border-orange focus:ring-2 focus:ring-orange/20 outline-none transition-all resize-none"></textarea>
            </div>
          </div>
        </div>

        <!-- Step 3: Dato og tid -->
        <div class="booking-step hidden" data-step="3">
          <h3 class="text-xl font-bold text-navy mb-2">Velg dato og tid</h3>
          <p class="text-gray-500 mb-6">Vi er åpne mandag–fredag 07:00–17:00</p>
          <div class="space-y-4">
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1.5">Ønsket dato</label>
              <input type="date" name="date" class="w-full px-4 py-3 bg-white rounded-xl border border-gray-200 focus:border-orange focus:ring-2 focus:ring-orange/20 outline-none transition-all" required />
            </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1.5">Ønsket tidspunkt</label>
              <select name="time" class="w-full px-4 py-3 bg-white rounded-xl border border-gray-200 focus:border-orange focus:ring-2 focus:ring-orange/20 outline-none transition-all" required>
                <option value="">Velg tidspunkt</option>
                <option value="07:00">07:00</option>
                <option value="07:30">07:30</option>
                <option value="08:00">08:00</option>
                <option value="08:30">08:30</option>
                <option value="09:00">09:00</option>
                <option value="09:30">09:30</option>
                <option value="10:00">10:00</option>
                <option value="10:30">10:30</option>
                <option value="11:00">11:00</option>
                <option value="11:30">11:30</option>
                <option value="12:00">12:00</option>
                <option value="12:30">12:30</option>
                <option value="13:00">13:00</option>
                <option value="13:30">13:30</option>
                <option value="14:00">14:00</option>
                <option value="14:30">14:30</option>
                <option value="15:00">15:00</option>
                <option value="15:30">15:30</option>
                <option value="16:00">16:00</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Step 4: Kontaktinfo -->
        <div class="booking-step hidden" data-step="4">
          <h3 class="text-xl font-bold text-navy mb-2">Kontaktinformasjon</h3>
          <p class="text-gray-500 mb-6">Slik at vi kan bekrefte timen din</p>
          <div class="space-y-4">
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1.5">Fullt navn</label>
              <input type="text" name="name" placeholder="Ola Nordmann" class="w-full px-4 py-3 bg-white rounded-xl border border-gray-200 focus:border-orange focus:ring-2 focus:ring-orange/20 outline-none transition-all" required />
            </div>
            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1.5">Telefon</label>
                <input type="tel" name="phone" placeholder="900 00 000" class="w-full px-4 py-3 bg-white rounded-xl border border-gray-200 focus:border-orange focus:ring-2 focus:ring-orange/20 outline-none transition-all" required />
              </div>
              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1.5">E-post</label>
                <input type="email" name="email" placeholder="din@epost.no" class="w-full px-4 py-3 bg-white rounded-xl border border-gray-200 focus:border-orange focus:ring-2 focus:ring-orange/20 outline-none transition-all" required />
              </div>
            </div>
          </div>
        </div>

        <!-- Navigation Buttons -->
        <div class="flex justify-between mt-8 pt-6 border-t border-gray-200">
          <button
            type="button"
            id="booking-prev"
            class="hidden px-6 py-3 bg-gray-100 text-gray-600 font-semibold rounded-xl hover:bg-gray-200 transition-all"
          >
            Tilbake
          </button>
          <div class="ml-auto">
            <button
              type="button"
              id="booking-next"
              class="px-8 py-3 bg-orange text-white font-bold rounded-xl hover:bg-orange-dark transition-all shadow-lg shadow-orange/25 hover:shadow-orange/40"
            >
              Neste steg
            </button>
            <button
              type="submit"
              id="booking-submit"
              class="hidden px-8 py-3 bg-green text-white font-bold rounded-xl hover:opacity-90 transition-all shadow-lg"
            >
              Send bestilling
            </button>
          </div>
        </div>
      </form>

      <!-- Success Message -->
      <div id="booking-success" class="hidden text-center py-16">
        <div class="w-20 h-20 bg-green/10 rounded-full flex items-center justify-center mx-auto mb-6">
          <svg class="w-10 h-10 text-green" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h3 class="text-2xl font-bold text-navy mb-3">Bestilling mottatt!</h3>
        <p class="text-gray-500 max-w-md mx-auto">Vi bekrefter timen din innen 2 timer. Sjekk e-posten din for bekreftelse.</p>
      </div>
    </div>
  </div>
</section>

<script>
  let currentStep = 1;
  const totalSteps = 4;

  const form = document.getElementById('booking-form') as HTMLFormElement;
  const prevBtn = document.getElementById('booking-prev');
  const nextBtn = document.getElementById('booking-next');
  const submitBtn = document.getElementById('booking-submit');
  const successMsg = document.getElementById('booking-success');

  function showStep(step: number) {
    document.querySelectorAll('.booking-step').forEach((el) => {
      (el as HTMLElement).classList.add('hidden');
    });
    const target = document.querySelector(`.booking-step[data-step="${step}"]`) as HTMLElement;
    target?.classList.remove('hidden');

    // Update indicators
    document.querySelectorAll('.booking-step-indicator').forEach((el) => {
      const s = parseInt(el.getAttribute('data-step') || '0');
      if (s <= step) {
        el.classList.add('bg-orange', 'text-white', 'shadow-lg', 'shadow-orange/30');
        el.classList.remove('bg-gray-100', 'text-gray-400');
      } else {
        el.classList.remove('bg-orange', 'text-white', 'shadow-lg', 'shadow-orange/30');
        el.classList.add('bg-gray-100', 'text-gray-400');
      }
    });

    // Update progress lines
    document.querySelectorAll('.booking-step-line').forEach((el) => {
      const afterStep = parseInt(el.getAttribute('data-after-step') || '0');
      (el as HTMLElement).style.width = afterStep < step ? '100%' : '0%';
    });

    // Toggle buttons
    if (prevBtn) prevBtn.classList.toggle('hidden', step === 1);
    if (nextBtn) nextBtn.classList.toggle('hidden', step === totalSteps);
    if (submitBtn) submitBtn.classList.toggle('hidden', step !== totalSteps);
  }

  // Service option highlighting
  document.querySelectorAll('.service-option input').forEach((input) => {
    input.addEventListener('change', () => {
      document.querySelectorAll('.service-option').forEach((label) => {
        label.classList.remove('border-orange', 'bg-orange/5');
      });
      const label = (input as HTMLElement).closest('.service-option');
      label?.classList.add('border-orange', 'bg-orange/5');
    });
  });

  // Set min date to today
  const dateInput = form?.querySelector('input[name="date"]') as HTMLInputElement;
  if (dateInput) {
    const today = new Date().toISOString().split('T')[0];
    dateInput.min = today;
  }

  nextBtn?.addEventListener('click', () => {
    // Validate current step
    const stepEl = document.querySelector(`.booking-step[data-step="${currentStep}"]`);
    const inputs = stepEl?.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[required]');
    let valid = true;
    inputs?.forEach((input) => {
      if (!input.checkValidity()) {
        input.reportValidity();
        valid = false;
      }
    });
    if (valid && currentStep < totalSteps) {
      currentStep++;
      showStep(currentStep);
    }
  });

  prevBtn?.addEventListener('click', () => {
    if (currentStep > 1) {
      currentStep--;
      showStep(currentStep);
    }
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    form.classList.add('hidden');
    successMsg?.classList.remove('hidden');
  });
</script>
