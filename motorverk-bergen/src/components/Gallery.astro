---
const images = [
  { alt: 'Verkstedhallen', label: 'Moderne verkstedhall' },
  { alt: 'Diagnostikk', label: 'Avansert diagnostikk' },
  { alt: 'Teamet', label: 'Vårt team' },
  { alt: 'Elbil-service', label: 'Elbil-spesialister' },
  { alt: 'Lakkeringskabin', label: 'Lakkeringskabin' },
  { alt: 'Kundemottak', label: 'Kundemottak' },
];
---

<section id="galleri" class="py-24 lg:py-32 bg-cream relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16 scroll-animate">
      <span class="inline-block px-4 py-1.5 bg-navy/10 text-navy font-semibold text-sm rounded-full mb-4">
        Galleri
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-navy mb-6">
        Se verkstedet vårt
      </h2>
      <p class="text-lg text-gray-500 leading-relaxed">
        Moderne fasiliteter og dedikerte fagfolk – ta en titt bak kulissene.
      </p>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 stagger-children">
      {images.map((image, i) => (
        <div class={`group relative rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-500 hover:-translate-y-1 ${i === 0 ? 'lg:col-span-2 lg:row-span-2' : ''}`}>
          <div class={`bg-gradient-to-br from-navy/80 to-navy-dark ${i === 0 ? 'aspect-[4/3] lg:aspect-auto lg:h-full' : 'aspect-[4/3]'}`}>
            <div class="w-full h-full flex items-center justify-center min-h-[200px]">
              <div class="text-center text-white/50 p-4">
                <svg class="w-12 h-12 mx-auto mb-2 opacity-30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 015.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 00-1.134-.175 2.31 2.31 0 01-1.64-1.055l-.822-1.316a2.192 2.192 0 00-1.736-1.039 48.774 48.774 0 00-5.232 0 2.192 2.192 0 00-1.736 1.039l-.821 1.316z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12.75a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0z" />
                </svg>
                <p class="text-xs sm:text-sm">{image.alt}</p>
              </div>
            </div>
          </div>
          <!-- Overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-navy/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-6">
            <span class="text-white font-semibold text-lg">{image.label}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
